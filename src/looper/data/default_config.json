    "pdca": {
      "description": "PDCA (Plan-Do-Check-Act): plan a change with a measurable target, do it, check against the target, act/standardize; repeat.",
      "priority": 2,
      "route": [
        {
          "keyword": "pdca",
          "weight": 6
        },
        {
          "keyword": "process",
          "weight": 2
        },
        {
          "keyword": "workflow",
          "weight": 1
        },
        {
          "regex": "\\bcontinuous(ly)? improv",
          "weight": 3
        },
        {
          "keyword": "kpi",
          "weight": 3
        },
        {
          "keyword": "metrics",
          "weight": 2
        },
        {
          "regex": "\\breduce\\b.*\\b(time|latency|cost|errors|churn)\\b",
          "weight": 3
        },
        {
          "keyword": "experiment",
          "weight": 2
        }
      ],
      "stages": [
        {
          "name": "plan",
          "role": "planner",
          "prompt": "TASK:\n{{task}}\n\nResults of the last cycle (if any):\n{{outputs.act}}\n\nPLAN: state the hypothesis, the change, and a measurable TARGET for this cycle (cycle {{iteration}})."
        },
        {
          "name": "do",
          "role": "coder",
          "prompt": "TASK:\n{{task}}\n\nPlan:\n{{outputs.plan}}\n\nDO: carry out the planned change.",
          "artifact": true,
          "agents": [
            "codex",
            "claude",
            "agy"
          ]
        },
        {
          "name": "check",
          "role": "evaluator",
          "prompt": "TASK:\n{{task}}\n\nPlan:\n{{outputs.plan}}\n\nWhat was done:\n{{outputs.do}}\n\nCHECK: measure the result against the TARGET. If met reply 'TARGET MET', else explain the gap."
        },
        {
          "name": "act",
          "role": "planner",
          "prompt": "TASK:\n{{task}}\n\nCheck results:\n{{outputs.check}}\n\nACT: standardize what worked and decide the next adjustment."
        }
      ],
      "iterate": {
        "body": [
          "plan",
          "do",
          "check",
          "act"
