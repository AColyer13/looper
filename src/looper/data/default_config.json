  "router": {
    "default_loop": "react",
    "min_score": 2
  },
  "loops": {
    "react": {
      "description": "ReAct: interleave Thought -> Action -> Observation until a final answer. General-purpose default.",
      "priority": 0,
      "route": [
        {
          "keyword": "quick",
          "weight": 1
        },
        {
          "keyword": "explain",
          "weight": 1
        },
        {
          "regex": "\\bhow (do|can|should) i\\b",
          "weight": 1
        },
        {
          "regex": "\\bwhat (is|are)\\b",
          "weight": 1
        }
      ],
      "stages": [
        {
          "name": "step",
          "role": "generalist",
          "prompt": "TASK:\n{{task}}\n\nWork in ReAct style. Iteration {{iteration}}.\nPrevious steps:\n{{outputs.step}}\n\nWrite one Thought, take the Action(s) you need (read files, run commands), and record the Observation. When the task is fully done, end with a line starting with 'FINAL ANSWER:' followed by the answer.",
          "artifact": true
        }
      ],
      "iterate": {
        "body": [
          "step"
        ],
        "max_iterations": 6,
        "exit_signals": [
          "FINAL ANSWER:"
        ]
      },
      "caps": {
        "max_total_calls": 8,
        "max_wall_seconds": 1800
      }
    },
    "explore_plan_code_commit": {
      "description": "Explore -> Plan -> Code -> Commit. Read the codebase first, plan, implement with a verify loop, then commit.",
      "priority": 5,
      "route": [
        {
          "keyword": "implement",
          "weight": 3
        },
        {
          "keyword": "build",
          "weight": 2
        },
        {
          "keyword": "feature",
          "weight": 2
        },
        {
          "keyword": "add",
          "weight": 1
        },
        {
          "keyword": "create",
          "weight": 1
        },
        {
          "keyword": "endpoint",
          "weight": 1
        },
        {
          "keyword": "refactor",
          "weight": 1
        },
        {
          "regex": "\\b(rate[- ]?limiter|cache|middleware|cli|api)\\b",
          "weight": 1
        }
      ],
      "stages": [
        {
          "name": "explore",
          "role": "explorer",
          "prompt": "TASK:\n{{task}}\n\nEXPLORE only: read the relevant files and summarize the code structure, conventions, and every place this task touches. Do NOT write code yet."
        },
        {
          "name": "plan",
          "role": "planner",
          "prompt": "TASK:\n{{task}}\n\nExploration notes:\n{{outputs.explore}}\n\nWrite a concrete step-by-step implementation plan (files, functions, tests). No code yet.",
          "mergeable": true
        },
        {
          "name": "code",
          "role": "coder",
          "prompt": "TASK:\n{{task}}\n\nPlan:\n{{outputs.plan}}\n\nReviewer feedback from the last round (if any):\n{{outputs.verify}}\n\nImplement the plan in the working tree. Run the tests/linters you can.",
          "artifact": true
        },
        {
          "name": "verify",
          "role": "reviewer",
          "prompt": "TASK:\n{{task}}\n\nPlan:\n{{outputs.plan}}\n\nImplementation report:\n{{outputs.code}}\n\nReview the actual changes in the working tree against the plan. Run tests. If everything is correct reply with 'LGTM' on its own line; otherwise list concrete fixes."
        },
        {
          "name": "commit",
          "role": "committer",
          "prompt": "TASK:\n{{task}}\n\nFinal review:\n{{outputs.verify}}\n\nStage the relevant changes and create a git commit with a clear conventional-commit message. Do not push. Report the commit hash.",
          "optional": true
        }
      ],
      "iterate": {
        "body": [
          "code",
          "verify"
        ],
        "max_iterations": 3,
        "exit_signals": [
          "LGTM"
        ],
        "check_stages": [
          "verify"
        ]
      },
      "caps": {
        "max_total_calls": 12,
        "max_wall_seconds": 3600
      }
    },
    "research_plan_implement": {
      "description": "Research -> Plan -> Implement. For unfamiliar libraries/APIs/migrations: gather facts before writing code.",
      "priority": 4,
      "route": [
        {
          "keyword": "integrate",
          "weight": 3
        },
        {
          "keyword": "migrate",
          "weight": 3
        },
        {
          "keyword": "migration",
          "weight": 3
        },
        {
          "keyword": "sdk",
          "weight": 2
        },
        {
          "keyword": "library",
          "weight": 1
        },
        {
          "keyword": "unfamiliar",
          "weight": 3
        },
        {
          "keyword": "upgrade",
          "weight": 2
        },
        {
          "regex": "\\bresearch\\b.*\\b(then|and)\\b.*\\b(implement|build|integrate)\\b",
          "weight": 5
        }
      ],
      "stages": [
        {
          "name": "research",
          "role": "researcher",
          "prompt": "TASK:\n{{task}}\n\nRESEARCH: find current docs, APIs, versions, gotchas and examples relevant to this task. Cite sources. Do not write project code."
        },
        {
          "name": "plan",
          "role": "planner",
          "prompt": "TASK:\n{{task}}\n\nResearch:\n{{outputs.research}}\n\nWrite an implementation plan grounded in the research.",
          "mergeable": true
        },
        {
          "name": "implement",
          "role": "coder",
          "prompt": "TASK:\n{{task}}\n\nPlan:\n{{outputs.plan}}\n\nResearch:\n{{outputs.research}}\n\nReview feedback (if any):\n{{outputs.review}}\n\nImplement the plan in the working tree and run tests.",
          "artifact": true,
          "agents": [
            "codex",
            "claude",
            "agy"
          ]
        },
        {
          "name": "review",
          "role": "reviewer",
          "prompt": "TASK:\n{{task}}\n\nPlan:\n{{outputs.plan}}\n\nImplementation report:\n{{outputs.implement}}\n\nReview the changes. Reply 'LGTM' if correct, else list fixes."
        }
      ],
      "iterate": {
        "body": [
          "implement",
          "review"
        ],
        "max_iterations": 3,
        "exit_signals": [
          "LGTM"
        ],
        "check_stages": [
          "review"
        ]
      },
      "caps": {
        "max_total_calls": 10,
        "max_wall_seconds": 3600
      }
    },
    "spec_driven": {
      "description": "Spec-driven development: write a spec with acceptance criteria, review it, then implement until the spec is satisfied.",
      "priority": 6,
      "route": [
        {
          "keyword": "spec",
          "weight": 4
        },
        {
          "keyword": "specification",
          "weight": 4
        },
        {
          "keyword": "prd",
          "weight": 4
        },
        {
          "keyword": "rfc",
          "weight": 3
        },
        {
          "regex": "\\bacceptance criteria\\b",
          "weight": 4
        },
        {
          "keyword": "requirements",
          "weight": 2
        },
        {
          "keyword": "design doc",
          "weight": 3
        }
      ],
      "stages": [
        {
          "name": "spec",
          "role": "planner",
          "prompt": "TASK:\n{{task}}\n\nWrite a precise SPEC: goals, non-goals, interfaces, data shapes, edge cases, and numbered ACCEPTANCE CRITERIA. Save it as SPEC.md if working in a repo."
        },
        {
          "name": "spec_review",
          "role": "reviewer",
          "prompt": "TASK:\n{{task}}\n\nSpec:\n{{outputs.spec}}\n\nCritique the spec for ambiguity and missing cases; output the corrected spec in full.",
          "optional": true
        },
        {
          "name": "implement",
          "role": "coder",
          "prompt": "TASK:\n{{task}}\n\nSpec:\n{{outputs.spec_review}}\n\nConformance feedback (if any):\n{{outputs.conformance}}\n\nImplement exactly to the spec. Run tests.",
          "artifact": true,
          "agents": [
            "codex",
            "claude",
            "agy"
          ]
        },
        {
          "name": "conformance",
          "role": "reviewer",
          "prompt": "TASK:\n{{task}}\n\nSpec:\n{{outputs.spec_review}}\n\nImplementation report:\n{{outputs.implement}}\n\nCheck every acceptance criterion against the working tree. If all pass reply 'SPEC SATISFIED'; otherwise list each failing criterion."
        }
      ],
      "iterate": {
        "body": [
          "implement",
          "conformance"
        ],
        "max_iterations": 3,
        "exit_signals": [
          "SPEC SATISFIED"
        ],
        "check_stages": [
          "conformance"
        ]
      },
      "caps": {
        "max_total_calls": 10,
        "max_wall_seconds": 3600
      }
    },
    "evaluator_optimizer": {
      "description": "Evaluator-Optimizer: a generator produces, an evaluator grades against criteria, the optimizer revises until it passes.",
      "priority": 3,
      "route": [
        {
          "keyword": "improve",
          "weight": 2
        },
        {
          "keyword": "optimize",
          "weight": 2
        },
        {
          "keyword": "optimise",
          "weight": 2
        },
        {
          "keyword": "refine",
          "weight": 2
        },
        {
          "keyword": "polish",
          "weight": 2
        },
        {
          "keyword": "iterate",
          "weight": 1
        },
        {
          "keyword": "quality",
          "weight": 1
        },
        {
