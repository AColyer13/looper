    },
    "researcher": {
      "abstract": "researcher",
      "tools": true
    },
    "scout": {
      "abstract": "researcher",
      "tools": true
    },
    "investigator": {
      "abstract": "researcher",
      "tools": true
    },
    "responder": {
      "abstract": "generalist",
