    },
    "orchestrator": {
      "abstract": "orchestrator",
      "lead": true
    },
    "worker": {
      "abstract": "worker",
      "tools": true
    },
    "candidate": {
      "abstract": "coder"
    },
    "judge": {
      "abstract": "judge",
      "lead": true
