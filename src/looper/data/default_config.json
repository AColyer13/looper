    "tdd": {
      "description": "Test-Driven Development: write a failing test (red), implement until green, then refactor.",
      "priority": 7,
      "route": [
        {
          "keyword": "tdd",
          "weight": 8
        },
        {
          "keyword": "test",
          "weight": 4
        },
        {
          "keyword": "tests",
          "weight": 4
        },
        {
          "regex": "\\bunit[- ]tests?\\b",
          "weight": 2
        },
        {
          "keyword": "coverage",
          "weight": 3
        },
        {
          "regex": "\\bred[ -/]green\\b",
          "weight": 5
        },
        {
          "regex": "\\badd (a |some )?(failing )?tests?\\b",
          "weight": 3
        },
        {
          "keyword": "pytest",
          "weight": 2
        },
        {
          "keyword": "jest",
          "weight": 2
        }
      ],
      "stages": [
        {
          "name": "write_test",
          "role": "tester",
          "prompt": "TASK:\n{{task}}\n\nRED: write the failing test(s) that capture the required behavior. Run them and confirm they fail for the right reason. Do not implement the feature."
        },
        {
          "name": "implement",
          "role": "coder",
          "prompt": "TASK:\n{{task}}\n\nTests written:\n{{outputs.write_test}}\n\nLast test run (if any):\n{{outputs.run_tests}}\n\nGREEN: write the minimal code to make the tests pass. Do not weaken the tests.",
          "artifact": true
        },
        {
          "name": "run_tests",
          "role": "tester",
          "prompt": "TASK:\n{{task}}\n\nRun the full relevant test suite and report results. If every test passes, include the exact line 'ALL TESTS PASS'; otherwise paste the failures."
        },
        {
          "name": "refactor",
          "role": "reviewer",
          "prompt": "TASK:\n{{task}}\n\nREFACTOR: clean up the implementation and tests without changing behavior, re-run tests, and summarize the final state.",
          "optional": true
        }
      ],
      "iterate": {
        "body": [
          "implement",
          "run_tests"
        ],
        "max_iterations": 5,
        "exit_signals": [
          "ALL TESTS PASS"
        ],
        "check_stages": [
          "run_tests"
        ]
      },
      "caps": {
        "max_total_calls": 14,
        "max_wall_seconds": 3600
      }
    },
