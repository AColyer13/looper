  "providers": {
    "anthropic": {
      "kind": "api",
      "vendor": "claude",
      "api_style": "anthropic",
      "base_url": "https://api.anthropic.com/v1",
      "api_key_env": "ANTHROPIC_API_KEY",
      "context_window": 1000000,
      "models": [
        "claude-opus-5-5",
        "claude-sonnet-5-5",
        "claude-haiku-5-5",
        "claude-fable-5-1"
      ]
    },
    "openai": {
      "kind": "api",
      "vendor": "codex",
      "api_style": "openai_responses",
      "base_url": "https://api.openai.com/v1",
      "api_key_env": "OPENAI_API_KEY",
      "context_window": 1050000,
      "models": [
        "gpt-6-astra",
        "gpt-6.1-sol",
        "gpt-6-luna"
      ]
    },
    "xai": {
      "kind": "api",
      "vendor": "grok",
      "api_style": "openai",
      "base_url": "https://api.x.ai/v1",
      "api_key_env": "XAI_API_KEY",
      "context_window": 500000,
      "models": [
        "grok-4.7",
        "grok-build-0.1",
        "grok-4.3"
      ]
    },
    "google": {
      "kind": "api",
      "vendor": "agy",
      "api_style": "openai",
      "base_url": "https://generativelanguage.googleapis.com/v1beta/openai",
      "api_key_env": "GEMINI_API_KEY",
      "context_window": 1000000,
      "models": [
        "gemini-4-argon",
        "gemini-3.8-flash",
        "gemini-3.5-flash-lite"
      ]
    },
    "openrouter": {
      "kind": "api",
      "api_style": "openai",
      "base_url": "https://openrouter.ai/api/v1",
      "api_key_env": "OPENROUTER_API_KEY",
      "context_window": null,
      "models": []
    },
    "ollama": {
      "kind": "local",
      "api_style": "ollama",
      "base_url": "http://localhost:11434",
      "api_key_env": null,
      "context_window": null,
      "models": []
    },
    "lmstudio": {
      "kind": "local",
      "api_style": "openai",
      "base_url": "http://localhost:1234/v1",
      "api_key_env": "LM_API_TOKEN",
      "key_optional": true,
      "context_window": null,
      "models": []
    },
    "openai_compatible": {
      "kind": "local",
      "api_style": "openai",
      "base_url": "http://localhost:8000/v1",
      "api_key_env": "LOOPER_COMPAT_API_KEY",
      "key_optional": true,
      "context_window": null,
      "models": []
    }
  },
  "agents": {
    "claude": {
      "description": "Claude Code (Anthropic). When caller tools are offered, looper adds plan-mode permission flags and disallows Edit/Write/NotebookEdit (best effort).",
      "binary": "claude",
      "command": [
        "{binary}",
        "-p",
        "{prompt}"
      ],
      "version_args": [
        "--version"
      ],
      "caller_tools_extra_args": [
        "--permission-mode",
        "plan",
        "--disallowedTools",
        "Edit,Write,NotebookEdit"
      ]
    },
    "codex": {
      "description": "Codex CLI (OpenAI). When caller tools are offered, looper adds read-only sandbox flags (best effort).",
      "binary": "codex",
      "command": [
        "{binary}",
        "exec",
        "--skip-git-repo-check",
        "{prompt}"
      ],
      "version_args": [
        "--version"
      ],
      "caller_tools_extra_args": [
        "--sandbox",
        "read-only",
        "--ask-for-approval",
        "never"
      ]
    },
    "grok": {
      "description": "Grok Build CLI (xAI) - headless via -p",
      "binary": "grok",
      "command": [
        "{binary}",
        "-p",
        "{prompt}",
        "--no-auto-update"
      ],
      "version_args": [
        "--version"
      ]
    },
    "agy": {
      "description": "Antigravity CLI (Google) - print mode via -p",
      "binary": "agy",
      "command": [
        "{binary}",
        "-p",
        "{prompt}"
      ],
      "version_args": [
        "--version"
      ]
    }
  },
