{
  "$schema_version": 3,
  "defaults": {
    "timeout_seconds": 900,
    "max_iterations": 3,
    "caps": {
      "max_total_calls": 20,
      "max_wall_seconds": 3600
    },
    "fallback_agents": [
      "claude",
      "codex",
      "grok",
      "agy"
    ],
    "fallback_on_error": true,
    "max_context_chars": 20000,
    "runs_dir": ".looper/runs",
    "version_probe_timeout": 3,
    "max_agents": 5,
    "recommended_agents": 3,
    "max_parallel_local": 1,
    "max_best_of_n": 5,
    "single_agent_samples": 2,
    "chars_per_token": 3.5,
    "context_fill": 0.5,
    "unknown_local_tier": "medium"
  },
  "tiers": {
    "tiny": {
      "rank": 0,
      "max_params_b": 1.5,
      "roles": [
        "summarizer",
        "classifier",
        "formatter"
      ],
      "examples": [
        "qwen3.5:0.8b",
        "gemma3:270m",
        "qwen3:0.6b",
        "llama3.2:1b"
      ],
      "num_ctx": 4096,
      "max_output_tokens": 1024,
      "max_context_chars": 6000,
      "structured_output": "unreliable",
      "iteration_multiplier": 0.34,
      "can_orchestrate": false,
      "max_map_items": 0,
      "best_of_n": false,
      "simplify_prompts": true,
      "disable_thinking": true,
      "note": "Utility only: summarize, classify, reformat. Multi-turn tool calling ~0-2% on BFCL."
    },
    "small": {
      "rank": 1,
      "max_params_b": 5,
      "roles": [
        "summarizer",
        "classifier",
        "formatter",
        "generalist",
        "worker",
        "coder",
        "tester",
        "editor",
        "researcher"
      ],
      "examples": [
        "qwen3.5:2b",
        "qwen3.5:4b",
        "gemma4:e4b",
        "phi4-mini:3.8b",
        "llama3.2:3b"
      ],
      "num_ctx": 8192,
      "max_output_tokens": 4096,
      "max_context_chars": 12000,
      "structured_output": "fair",
      "iteration_multiplier": 0.67,
      "can_orchestrate": false,
      "max_map_items": 3,
      "best_of_n": false,
      "simplify_prompts": true,
      "disable_thinking": true,
      "note": "Simple single-file edits and tests; no planning, judging or orchestration."
    },
    "medium": {
      "rank": 2,
      "max_params_b": 15,
      "roles": [
        "summarizer",
        "classifier",
        "formatter",
        "generalist",
        "worker",
        "coder",
        "tester",
        "editor",
        "researcher",
        "planner",
        "reviewer",
        "judge"
      ],
      "examples": [
        "qwen3.5:9b",
        "qwen3:14b",
        "gpt-oss:20b",
        "qwen3.6:35b-a3b",
        "gemma4:26b-a4b"
      ],
      "num_ctx": 16384,
      "max_output_tokens": 4096,
      "max_context_chars": 24000,
      "structured_output": "good",
      "iteration_multiplier": 1.0,
      "can_orchestrate": false,
      "max_map_items": 4,
      "best_of_n": true,
      "simplify_prompts": false,
      "disable_thinking": false,
      "note": "Coder/tester; can plan and judge with care (lower agreement than 70B+ judges)."
    },
    "large": {
      "rank": 3,
      "max_params_b": 40,
      "roles": [
        "summarizer",
        "classifier",
        "formatter",
        "generalist",
        "worker",
        "coder",
        "tester",
        "editor",
        "researcher",
        "planner",
        "reviewer",
        "judge",
        "orchestrator"
      ],
      "examples": [
        "qwen3.6:27b",
        "qwen3.8:27b",
        "gemma4:31b",
        "gpt-oss:120b",
        "qwen3.5:122b-a10b"
      ],
      "num_ctx": 32768,
      "max_output_tokens": 8192,
      "max_context_chars": 48000,
      "structured_output": "reliable",
      "iteration_multiplier": 1.0,
      "can_orchestrate": true,
      "max_map_items": 6,
      "best_of_n": true,
      "simplify_prompts": false,
      "disable_thinking": false,
      "note": "Full roles incl. planner/judge/orchestrator. Best local value per GB."
    },
    "xl": {
      "rank": 4,
      "max_params_b": null,
      "roles": [
        "summarizer",
        "classifier",
        "formatter",
        "generalist",
        "worker",
        "coder",
        "tester",
        "editor",
        "researcher",
        "planner",
        "reviewer",
        "judge",
        "orchestrator"
      ],
      "examples": [
        "llama3.3:70b",
        "qwen3.5:397b-a17b",
        "llama4:scout (109b-a17b)"
      ],
      "num_ctx": 65536,
      "max_output_tokens": 8192,
      "max_context_chars": 80000,
      "structured_output": "reliable",
      "iteration_multiplier": 1.0,
      "can_orchestrate": true,
      "max_map_items": 6,
      "best_of_n": true,
      "simplify_prompts": false,
      "disable_thinking": false,
      "note": "Near-frontier locally; needs 48GB+ VRAM or large unified memory / expert offload."
    },
    "frontier": {
      "rank": 5,
      "max_params_b": null,
      "roles": [
        "summarizer",
        "classifier",
        "formatter",
        "generalist",
        "worker",
        "coder",
        "tester",
        "editor",
        "researcher",
        "planner",
        "reviewer",
        "judge",
        "orchestrator"
      ],
      "examples": [
        "claude-opus-5-5",
        "gpt-6-astra",
        "grok-4.7",
        "gemini-4-argon",
        "any agent CLI"
      ],
      "num_ctx": null,
      "max_output_tokens": 16000,
      "max_context_chars": 120000,
      "structured_output": "reliable",
      "iteration_multiplier": 1.0,
      "can_orchestrate": true,
      "max_map_items": 8,
      "best_of_n": true,
      "simplify_prompts": false,
      "disable_thinking": false,
      "note": "Hosted frontier APIs and agent CLIs. Default tier for kind=cli and first-party APIs."
    }
  },
