{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AColyer13/looper/docs/tool_call.schema.json",
  "title": "looper ask tool-calling shapes (api_version 1, package >= 0.7.0)",
  "description": "Caller-owned tool calls are signaled for the caller to run. looper executes load_skill and auto-approved MCP tools itself. Other MCP calls are returned on pending for approval.",
  "$defs": {
    "tool": {
      "type": "object",
      "required": ["name", "parameters"],
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "parameters": {
          "type": "object",
          "description": "JSON Schema for the tool arguments",
          "properties": {
            "type": { "const": "object" },
            "properties": { "type": "object" },
            "required": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    },
    "tool_call": {
      "type": "object",
      "required": ["id", "tool", "args"],
      "description": "Flattened argument fields are also present alongside args for convenience.",
      "properties": {
        "id": { "type": "string" },
        "tool": { "type": "string" },
        "args": { "type": "object", "additionalProperties": true }
      },
      "additionalProperties": true
    },
    "tool_result": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "description": "Matches tool_call.id" },
        "tool": { "type": "string" },
        "ok": { "type": "boolean" },
        "output": { "type": ["string", "object", "array", "number", "boolean", "null"] },
        "error": { "type": "string" }
      }
    },
    "message": {
      "type": "object",
      "required": ["role"],
      "properties": {
        "role": { "enum": ["system", "user", "assistant", "tool"] },
        "content": { "type": "string" },
        "tool_calls": { "type": "array", "items": { "$ref": "#/$defs/tool_call" } },
        "tool_call_id": { "type": "string" },
        "tool": { "type": "string" },
        "ok": { "type": "boolean" }
      }
    },
    "ask_request": {
      "type": "object",
      "properties": {
        "agent": { "type": "string" },
        "prompt": { "type": "string" },
        "system": { "type": "string" },
        "tools": { "type": "array", "items": { "$ref": "#/$defs/tool" } },
        "messages": { "type": "array", "items": { "$ref": "#/$defs/message" } },
        "tool_results": { "type": "array", "items": { "$ref": "#/$defs/tool_result" } },
        "max_tool_calls": { "type": "integer", "minimum": 0 },
        "protocol": { "enum": ["native", "json_block", "none"] },
        "cwd": { "type": "string" },
        "timeout": { "type": "number" },
        "max_tokens": { "type": "integer" },
        "temperature": { "type": "number" },
        "team": {},
        "project": { "type": "string", "description": "Project root. Overrides walking up from cwd for .looper/." },
        "role": { "type": "string", "description": "Role name; loads <project>/.looper/roles/<role>.md" },
        "approvals": {
          "type": "array",
          "description": "Resume an approval_required turn. Stateless: arguments come from messages.",
          "items": {
            "type": "object",
            "required": ["id", "decision"],
            "properties": {
              "id": { "type": "string" },
              "decision": { "enum": ["approve", "deny"] },
              "reason": { "type": "string" }
            }
          }
        },
        "history_trim": {
          "description": "Per-request override; false disables. Additive api_version 1.",
          "oneOf": [
            { "type": "boolean" },
            {
              "type": "object",
              "properties": {
                "enabled": { "type": "boolean" },
                "budget_fill": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
                "write_recent_turns": { "type": "integer", "minimum": 0 },
                "result_keep_recent_turns": { "type": "integer", "minimum": 0 },
                "head_lines": { "type": "integer", "minimum": 0 },
                "tail_lines": { "type": "integer", "minimum": 0 },
                "max_tool_result_lines": { "type": "integer", "minimum": 0 },
                "keep_error_lines": { "type": "boolean" },
                "keep_recent_turns": { "type": "integer", "minimum": 0 }
              },
              "additionalProperties": false
            }
          ]
        }
      }
    },
    "ask_response": {
      "type": "object",
      "required": ["ok", "text", "tool_calls", "finish_reason", "protocol", "messages", "agent"],
      "properties": {
        "ok": { "type": "boolean" },
        "text": { "type": "string" },
        "tool_calls": { "type": "array", "items": { "$ref": "#/$defs/tool_call" } },
        "finish_reason": { "enum": ["stop", "tool_calls", "invalid_tool_calls", "length", "error", "approval_required"] },
        "pending": {
          "type": "array",
          "description": "MCP calls looper did not run. Present when finish_reason is approval_required.",
          "items": {
            "type": "object",
            "required": ["id", "tool", "server", "name", "args", "reason"],
            "properties": {
              "id": { "type": "string" },
              "tool": { "type": "string", "description": "Exposed name mcp__<server>__<tool>" },
              "server": { "type": "string" },
              "name": { "type": "string", "description": "Tool name on the MCP server" },
              "args": { "type": "object" },
              "reason": { "type": "string", "enum": ["not_read_only", "destructive", "require_approval", "approve_all"] },
              "annotations": { "type": "object" }
            }
          }
        },
        "protocol": { "enum": ["native", "json_block", "none"] },
        "messages": { "type": "array", "items": { "$ref": "#/$defs/message" } },
        "agent": { "type": "object" },
        "seconds": { "type": "number" },
        "error": { "type": ["string", "null"] },
        "usage": { "type": ["object", "null"] },
        "warnings": { "type": "array", "items": { "type": "string" } },
        "trim": {
          "type": "object",
          "description": "What was sent to the provider; messages stay full/untrimmed.",
          "properties": {
            "applied": { "type": "boolean" },
            "before_tokens": { "type": "integer" },
            "after_tokens": { "type": "integer" },
            "budget": { "type": ["integer", "null"] },
            "steps": {
              "type": "array",
              "items": { "type": "object", "additionalProperties": true }
            }
          },
          "required": ["applied", "before_tokens", "after_tokens", "steps"]
        }
      }
    }
  }
}
